{% comment %}
  Renders a product card.
  Accepts: product
{% endcomment %}
<a href="{{ product.url }}" class="product-card">
  <div class="product-card__media">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
    {% endif %}
    {% if product.tags contains 'new' or product.tags contains 'Nowość' %}
      <span class="badge">New</span>
    {% endif %}
  </div>
  <div class="product-card__meta">
    <div>
      <h3>{{ product.title }}</h3>
      {% if product.metafields.descriptors.subtitle != blank %}
        <p style="margin:0.35rem 0 0;font-size:0.85rem;color:var(--color-muted);max-width:36ch;">{{ product.metafields.descriptors.subtitle }}</p>
      {% endif %}
    </div>
    <span class="product-card__price">
      {% if product.price_varies %}{{ 'product.from' | t }} {% endif %}{{ product.price | money }}
    </span>
  </div>
</a>
