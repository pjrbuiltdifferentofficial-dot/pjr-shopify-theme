{% doc %}
  Renders a product card. Skips any product whose handle or title contains bober or qrwa.
  @param {product} product
{% enddoc %}
{%- capture pjr_gate -%}{%- render 'product-gate', product: product -%}{%- endcapture -%}
{%- assign pjr_gate = pjr_gate | strip -%}
{%- if pjr_gate == blank -%}
<a href="{{ product.url }}" class="product-card">
  <div class="product-card__media">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', sizes: 'auto', alt: product.title }}
    {% endif %}
    {% if product.tags contains 'new' or product.tags contains 'Nowość' %}
      <span class="badge">New</span>
    {% endif %}
  </div>
  <div class="product-card__meta">
    <div>
      <h3>{{ product.title }}</h3>
      {% if product.metafields.descriptors.subtitle != blank %}
        <p class="product-card__sub">{{ product.metafields.descriptors.subtitle }}</p>
      {% endif %}
    </div>
    <span class="product-card__price">
      {% if product.price_varies %}{{ 'product.from' | t }} {% endif %}{{ product.price | money_without_trailing_zeros }}
    </span>
  </div>
</a>
{%- endif -%}
