<div class="drawer-backdrop" data-cart-backdrop></div>
<span hidden data-qty-labels data-decrease="{{ 'cart.decrease' | t | escape }}" data-increase="{{ 'cart.increase' | t | escape }}"></span>
<aside class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-hidden="true" inert aria-labelledby="CartDrawerTitle">
  <header class="cart-drawer__head">
    <div>
      <h2 id="CartDrawerTitle">{{ 'cart.title' | t }}</h2>
      <p class="kicker" style="margin:0.2rem 0 0;"><span data-cart-count>{{ cart.item_count }}</span> {{ 'cart.pieces' | t }}</p>
    </div>
    <button type="button" class="site-header__icon" data-close-cart aria-label="{{ 'general.close' | t }}">
      {% render 'icon-close' %}
    </button>
  </header>
  <div class="cart-drawer__body">
    <div data-cart-empty {% if cart.item_count > 0 %}hidden{% endif %}>
      <p class="kicker" style="font-size:1.4rem;color:var(--color-fg);">{{ 'cart.empty' | t }}</p>
      {%- capture shop_url -%}{%- render 'collection-url', handle: 'new-in', fallback: 'mens' -%}{%- endcapture -%}
      <a class="btn" href="{{ shop_url | strip }}" style="margin-top:1.25rem;" data-close-cart>{{ 'cart.empty_cta' | t }}</a>
    </div>
    <div data-cart-items>
      {% for item in cart.items %}
        <div class="cart-line" data-key="{{ item.key }}">
          <a href="{{ item.url }}">
            {% if item.image %}{{ item.image | image_url: width: 200 | image_tag: alt: item.title }}{% endif %}
          </a>
          <div>
            <div class="cart-line__title">{{ item.product_title }}</div>
            <div class="cart-line__meta">{{ item.variant_title }}</div>
            <div class="qty">
              <button type="button" data-qty="-1" aria-label="{{ 'cart.decrease' | t }}">−</button>
              <span>{{ item.quantity }}</span>
              <button type="button" data-qty="1" aria-label="{{ 'cart.increase' | t }}">+</button>
            </div>
          </div>
          <div>{{ item.final_line_price | money_without_trailing_zeros }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
  <footer class="cart-drawer__foot" data-cart-foot {% if cart.item_count == 0 %}hidden{% endif %}>
    <div class="cart-row">
      <span>{{ 'cart.subtotal' | t }}</span>
      <span data-cart-subtotal>{{ cart.total_price | money_without_trailing_zeros }}</span>
    </div>
    {% render 'shipping-note', total: cart.total_price %}
    <a class="btn btn--full" href="/checkout" style="margin-top:1.25rem;">{{ 'cart.checkout' | t }}</a>
    <button type="button" class="btn btn--line btn--full" data-close-cart style="margin-top:0.75rem;">{{ 'cart.continue' | t }}</button>
  </footer>
</aside>
