<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {% render 'seo' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'theme-edit.css' | asset_url | stylesheet_tag }}
    {% if settings.favicon %}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">
    {% else %}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {% endif %}
    <style>
      :root {
        --color-bg: {{ settings.color_bg }};
        --color-fg: {{ settings.color_fg }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-fg: {{ settings.color_accent_fg }};
      }
    </style>
    {{ content_for_header }}
  </head>
  <body>
    <a class="visually-hidden" href="#MainContent">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
