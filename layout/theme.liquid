<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="google-site-verification" content="zC4i7lqcbpZCgA9RcbxwAHgpGvmiOnvzAq8ziWLgX7Q">
    {%- comment -%}Inline SEO so the live theme never 404s on snippets/seo.liquid{%- endcomment -%}
    {%- liquid
      assign seo_title = page_title
      if request.page_type == 'index' and page_title == shop.name
        assign seo_title = shop.name | append: ' | Premium streetwear for the grind'
      endif
      unless seo_title contains shop.name
        assign seo_title = seo_title | append: ' | ' | append: shop.name
      endunless
      assign seo_desc = page_description | default: '' | strip_html | strip
      if seo_desc == blank
        assign seo_desc = 'Heavy jersey. Garment dye. Cut for the shift. Twenty years in the kitchen — no investors, no shortcuts. PJR Built Different.'
      endif
    -%}
    <title>{{ seo_title | escape }}</title>
    <meta name="description" content="{{ seo_desc | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:title" content="{{ seo_title | escape }}">
    <meta property="og:description" content="{{ seo_desc | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'theme-edit.css' | asset_url | stylesheet_tag }}
    {% if settings.favicon %}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">
    {% else %}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {% endif %}
    <style>
      :root {
        --color-bg: {{ settings.color_bg }};
        --color-fg: {{ settings.color_fg }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-fg: {{ settings.color_accent_fg }};
      }
    </style>
    {{ content_for_header }}
  </head>
  <body>
    <a class="visually-hidden" href="#MainContent">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
