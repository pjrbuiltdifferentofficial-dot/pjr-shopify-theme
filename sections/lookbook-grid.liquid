<section>
  {% if section.settings.heading != blank %}
    <div class="page-width" style="padding:2.5rem 0 1.5rem;display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;">
      <div>
        <p class="kicker">{{ section.settings.kicker }}</p>
        <h2 style="margin-top:0.5rem;font-size:var(--text-title);text-transform:uppercase;">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.cta != blank %}
        <a class="btn btn--line" href="{{ section.settings.link | default: pages.lookbook.url | default: '/pages/lookbook' }}">{{ section.settings.cta }}</a>
      {% endif %}
    </div>
  {% endif %}
  <div class="look-grid">
    {% assign fallbacks = 'lookbook-oscar.jpg,lookbook-father.jpg,lookbook-bloom.jpg,lookbook-piotr.jpg' | split: ',' %}
    {% assign labels = 'Kitchen,Fjord,Shift,Line' | split: ',' %}
    {% for block in section.blocks %}
      {% assign href = block.settings.link | default: routes.all_products_collection_url %}
      {% assign fb = fallbacks[forloop.index0] %}
      <a href="{{ href }}" class="look-cell" {{ block.shopify_attributes }}>
        {% if fb != blank %}
          <img src="{{ fb | asset_url }}" alt="{{ block.settings.alt | default: labels[forloop.index0] | escape }}" loading="lazy" width="900" height="1200">
        {% elsif block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.alt }}
        {% else %}
          <span class="look-ph">
            <span class="kicker">{{ block.settings.alt | default: labels[forloop.index0] | default: 'PJR' }}</span>
          </span>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook strip",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Campaign" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built between the shifts." },
    { "type": "text", "id": "cta", "label": "Link", "default": "Lookbook" },
    { "type": "url", "id": "link", "label": "URL" }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "Shot",
      "settings": [
        { "type": "text", "id": "alt", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook strip",
      "blocks": [
        { "type": "shot", "settings": { "alt": "Kitchen" } },
        { "type": "shot", "settings": { "alt": "Fjord" } },
        { "type": "shot", "settings": { "alt": "Shift" } },
        { "type": "shot", "settings": { "alt": "Line" } }
      ]
    }
  ]
}
{% endschema %}
