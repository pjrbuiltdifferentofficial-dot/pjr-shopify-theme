<section>
  {% if section.settings.heading != blank %}
    <div class="page-width" style="padding:2.5rem 0 1.5rem;display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;">
      <div>
        <p class="kicker">{{ section.settings.kicker }}</p>
        <h2 style="margin-top:0.5rem;font-size:var(--text-title);text-transform:uppercase;">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.cta != blank %}
        <a class="btn btn--line" href="{{ section.settings.link | default: pages.lookbook.url | default: '/pages/lookbook' }}">{{ section.settings.cta }}</a>
      {% endif %}
    </div>
  {% endif %}
  <div class="look-grid">
    {% assign shots = 'lookbook-maroon.jpg,lookbook-fare-front.jpg,lookbook-fare-back.jpg,lookbook-polo.jpg,lookbook-noordinary.jpg,lookbook-woman-noordinary.jpg,lookbook-father.jpg,lookbook-oscar.jpg' | split: ',' %}
    {% assign labels = 'Maroon,Festival,Festival back,Polo,No Ordinary,No Ordinary,Father,Oscar' | split: ',' %}
    {% for fb in shots %}
      <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="look-cell">
        <img src="{{ fb | asset_url }}" alt="{{ labels[forloop.index0] | escape }}" loading="lazy" width="900" height="1200">
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook strip",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Campaign" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built between the shifts." },
    { "type": "text", "id": "cta", "label": "Link", "default": "Lookbook" },
    { "type": "url", "id": "link", "label": "URL" }
  ],
  "presets": [{ "name": "Lookbook strip" }]
}
{% endschema %}
