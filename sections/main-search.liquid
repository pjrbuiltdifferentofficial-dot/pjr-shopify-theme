<div class="page-width section">
  <h1 style="font-size:var(--text-title);text-transform:uppercase;">{{ 'general.search' | t }}</h1>
  <form action="{{ routes.search_url }}" class="newsletter" style="max-width:32rem;margin-top:1.5rem;">
    <input class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}">
    <button class="btn" type="submit">{{ 'general.search' | t }}</button>
  </form>
  {% if search.performed %}
    <div class="product-grid product-grid--3" style="margin-top:2.5rem;">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'product-card', product: item %}
        {% endif %}
      {% else %}
        <p style="color:var(--color-muted);">—</p>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
