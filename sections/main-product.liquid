{% assign current = product.selected_or_first_available_variant %}
<div class="page-width product">
  <div>
    <div class="product__stage">
      {% if product.featured_image %}
        <img data-stage src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}">
      {% endif %}
    </div>
    {% if product.images.size > 1 %}
      <div class="thumbs">
        {% for image in product.images %}
          <button type="button" data-thumb="{{ image | image_url: width: 1400 }}" class="{% if forloop.first %}is-active{% endif %}">
            {{ image | image_url: width: 240 | image_tag: alt: image.alt }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div>
    <p class="product__sku">{{ product.vendor }}{% if product.metafields.descriptors.fabric != blank %} · {{ product.metafields.descriptors.fabric }}{% endif %}</p>
    <h1>{{ product.title }}</h1>
    {% if product.metafields.descriptors.subtitle != blank %}
      <p class="product__tag">{{ product.metafields.descriptors.subtitle }}</p>
    {% endif %}
    <p class="product__price" data-product-price>{{ current.price | money }}</p>

    {% assign added_label = 'cart.added' | t %}
    {% assign need_size = 'cart.need_size' | t %}
    {% form 'product', product, data-product-form: '', data-added: added_label, data-need-size: need_size %}
      <select name="id" class="visually-hidden" aria-hidden="true">
        {% for variant in product.variants %}
          <option value="{{ variant.id }}" {% if variant == current %}selected{% endif %}>{{ variant.title }}</option>
        {% endfor %}
      </select>

      {% for option in product.options_with_values %}
        <div class="option" data-option>
          <div class="option__label"><span>{{ option.name }}</span></div>
          <div class="{% if option.name == 'Color' or option.name == 'Kolor' %}swatches{% else %}sizes{% endif %}">
            {% for value in option.values %}
              <button
                type="button"
                class="size{% if option.selected_value == value %} is-active{% endif %}"
                data-value="{{ value | escape }}"
              >{{ value }}</button>
            {% endfor %}
          </div>
        </div>
      {% endfor %}

      {%- assign pf = product.metafields.custom.pf_id.value | append: '' -%}
      {%- capture size_chart -%}{% render 'pf-specs', pf: pf, part: 'sizes' %}{%- endcapture -%}
      {%- if size_chart != blank -%}
        <details class="size-guide">
          <summary>Size guide</summary>
          {{ size_chart }}
          <p class="size-guide__note">Garment measurements in cm, laid flat. Measurements may vary by up to 5 cm.</p>
        </details>
      {%- endif -%}

      <button
        type="submit"
        class="btn btn--full"
        style="margin-top:2rem;"
        data-add
        data-in-stock="{{ 'product.add' | t }} — {{ current.price | money }}"
        data-sold-out="{{ 'product.sold_out' | t }}"
        {% unless current.available %}disabled{% endunless %}
      >
        {% if current.available %}{{ 'product.add' | t }} — {{ current.price | money }}{% else %}{{ 'product.sold_out' | t }}{% endif %}
      </button>
    {% endform %}

    <ul class="product__assure">
      <li>Made to order — ships in 2–5 business days</li>
      <li>Tracked delivery worldwide</li>
      <li>14-day returns in the EU, EEA, Norway and UK · <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Returns policy</a></li>
    </ul>

    <script type="application/json" data-product-json>
      {{ product | json }}
    </script>

    <div class="product-tabs">
      <div class="product-tabs__nav">
        <button type="button" class="is-active" data-tab="story">{{ 'product.story' | t }}</button>
        <button type="button" data-tab="details">{{ 'product.details' | t }}</button>
      </div>
      <div class="product-tabs__panel rte" data-tab-panel="story">
        {{ product.description }}
      </div>
      <div class="product-tabs__panel rte" data-tab-panel="details" hidden>
        {% if product.metafields.descriptors.details != blank %}
          {{ product.metafields.descriptors.details }}
        {% else %}
          {%- capture pf_details -%}{% render 'pf-specs', pf: pf, part: 'details' %}{%- endcapture -%}
          {%- if pf_details != blank -%}{{ pf_details }}{%- else -%}
          <ul>
            {% for tag in product.tags %}
              <li>{{ tag }}</li>
            {% endfor %}
          </ul>
          {%- endif -%}
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .size-guide { margin-top: 1.25rem; font-size: 13px; }
  .size-guide summary { cursor: pointer; text-transform: uppercase; letter-spacing: .12em; font-size: 12px; text-decoration: underline; text-underline-offset: 3px; }
  .size-table { width: 100%; border-collapse: collapse; margin-top: .75rem; }
  .size-table th, .size-table td { border: 1px solid rgba(255,255,255,.15); padding: 6px 8px; text-align: center; }
  .size-table th { font-weight: 500; }
  .size-guide__note { opacity: .7; margin-top: .5rem; }
  .product__assure { list-style: none; padding: 0; margin: 1.25rem 0 0; font-size: 13px; opacity: .85; }
  .product__assure li { padding: 3px 0; }
  .product__assure li::before { content: "✓ "; }
</style>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
