<section class="section">
  <div class="page-width">
    <div class="section__head">
      <div>
        {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.sub != blank %}<p class="section__sub">{{ section.settings.sub }}</p>{% endif %}
      </div>
      {% if section.settings.cta != blank %}
        {%- capture featured_url -%}{%- render 'collection-url', handle: 'new-in', fallback: 'mens' -%}{%- endcapture -%}
        <a class="btn btn--line" href="{{ section.settings.cta_link | default: featured_url | strip }}">{{ section.settings.cta }}</a>
      {% endif %}
    </div>

    {% assign featured = section.settings.collection %}
    <div class="product-grid product-grid--4">
      {% assign shown = 0 %}
      {% assign limit = section.settings.limit | times: 1 %}
      {% if featured != blank %}
        {% for product in featured.products %}
          {% if shown >= limit %}{% break %}{% endif %}
          {% assign t = product.title | downcase %}
          {% assign ty = product.type | downcase %}
          {% capture gate %}{% render 'product-gate', product: product, apparel_only: true %}{% endcapture %}
          {% assign gate = gate | strip %}
          {% if gate != blank or t contains 'baby' or t contains 'onesie' or t contains 'infant' or t contains 'toddler' or t contains 'vroom' or t contains 'kids' or ty contains 'kid' or ty contains 'baby' %}
          {% else %}
            {% render 'product-card', product: product %}
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% assign fallback_pool = collections.mens.products | concat: collections.womens.products | sort: 'created_at' | reverse %}
        {% for product in fallback_pool %}
          {% if shown >= limit %}{% break %}{% endif %}
          {% capture gate %}{% render 'product-gate', product: product, apparel_only: true %}{% endcapture %}
          {% assign gate = gate | strip %}
          {% if gate == blank %}
            {% render 'product-card', product: product %}
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Core" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The capsule" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Not a weekly drop. Pieces built to stay." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 6 },
    { "type": "text", "id": "cta", "label": "Link label", "default": "Shop the capsule" },
    { "type": "url", "id": "cta_link", "label": "Link" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
