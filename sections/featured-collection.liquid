<section class="section">
  <div class="page-width">
    <div class="section__head">
      <div>
        {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.sub != blank %}<p class="section__sub">{{ section.settings.sub }}</p>{% endif %}
      </div>
      {% if section.settings.cta != blank %}
        <a class="btn btn--line" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta }}</a>
      {% endif %}
    </div>

    {% assign featured = section.settings.collection %}
    {% if featured == blank %}
      {% assign try_handles = 'the-core,core,mens,men,men-s,legacy' | split: ',' %}
      {% for h in try_handles %}
        {% if collections[h].products_count > 0 %}
          {% assign featured = collections[h] %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}

    <div class="product-grid product-grid--4">
      {% assign shown = 0 %}
      {% assign limit = section.settings.limit %}
      {% if featured != blank %}
        {% for product in featured.products %}
          {% if shown >= limit %}{% break %}{% endif %}
          {% render 'product-card', product: product %}
          {% assign shown = shown | plus: 1 %}
        {% endfor %}
      {% else %}
        {% for product in collections.all.products %}
          {% if shown >= limit %}{% break %}{% endif %}
          {% assign t = product.title | downcase %}
          {% assign ty = product.type | downcase %}
          {% if t contains 'bikini' or t contains 'rash' or t contains 'swim' or ty contains 'swim' %}
          {% else %}
            {% render 'product-card', product: product %}
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Core" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The capsule" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Not a weekly drop. Pieces built to stay." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "cta", "label": "Link label", "default": "Full shop" },
    { "type": "url", "id": "cta_link", "label": "Link" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
