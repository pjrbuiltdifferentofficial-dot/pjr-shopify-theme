<section class="section cat-tiles">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section__head">
        <div>
          {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif %}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
    {% endif %}
    <div class="cat-tiles__grid">
      {% for block in section.blocks %}
        {%- capture tile_url -%}{%- render 'collection-url', handle: block.settings.handle, fallback: block.settings.fallback, fallback_b: block.settings.fallback_b -%}{%- endcapture -%}
        {%- assign tile_col = collections[block.settings.handle] -%}
        {%- if tile_col.products_count == 0 and block.settings.fallback != blank -%}
          {%- assign tile_col = collections[block.settings.fallback] -%}
        {%- endif -%}
        {%- if tile_col.products_count == 0 and block.settings.fallback_b != blank -%}
          {%- assign tile_col = collections[block.settings.fallback_b] -%}
        {%- endif -%}
        {%- assign tile_image = nil -%}
        {%- for product in tile_col.products -%}
          {%- capture gate -%}{%- render 'product-gate', product: product, apparel_only: true -%}{%- endcapture -%}
          {%- assign gate = gate | strip -%}
          {%- if gate == blank and product.featured_image -%}
            {%- assign tile_image = product.featured_image -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        <a class="cat-tile" href="{{ tile_url | strip }}" {{ block.shopify_attributes }}>
          <span class="cat-tile__media">
            {% if tile_image %}
              {{ tile_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 480, 720, 900', sizes: 'auto', alt: block.settings.label }}
            {% endif %}
          </span>
          <span class="cat-tile__label">{{ block.settings.label }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.cat-tiles__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
}
@media (min-width: 1024px) {
  .cat-tiles__grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
}
.cat-tile {
  position: relative;
  display: flex;
  min-height: 14rem;
  align-items: flex-end;
  padding: 1.1rem 1.15rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  overflow: hidden;
}
@media (min-width: 1024px) {
  .cat-tile { min-height: 18rem; }
}
.cat-tile__media {
  position: absolute;
  inset: 0;
}
.cat-tile__media::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(12, 11, 9, 0.88) 0%, rgba(12, 11, 9, 0.18) 52%, rgba(12, 11, 9, 0.08) 100%);
}
.cat-tile__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s var(--ease-out);
}
.cat-tile:hover img { transform: scale(1.05); }
.cat-tile__label {
  position: relative;
  font-family: var(--font-display);
  font-size: clamp(1.25rem, 2vw, 1.9rem);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Catalog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by cut" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Hoodies" },
        { "type": "text", "id": "handle", "label": "Collection handle", "default": "hoodies" },
        { "type": "text", "id": "fallback", "label": "Fallback handle", "default": "mens" },
        { "type": "text", "id": "fallback_b", "label": "Second fallback handle" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Hoodies", "handle": "hoodies", "fallback": "mens" } },
        { "type": "tile", "settings": { "label": "T-shirts", "handle": "t-shirts", "fallback": "mens" } },
        { "type": "tile", "settings": { "label": "Sweatshirts", "handle": "sweatshirts", "fallback": "mens" } },
        { "type": "tile", "settings": { "label": "Headwear", "handle": "headwear", "fallback": "headwear-collection", "fallback_b": "caps-hats" } },
        { "type": "tile", "settings": { "label": "Men", "handle": "mens" } },
        { "type": "tile", "settings": { "label": "Women", "handle": "womens" } }
      ]
    }
  ]
}
{% endschema %}
