<section class="pin-promo">
  <a class="pin-promo__media" href="{{ section.settings.link | default: '/discount/PINTEREST10' }}">
    <img
      src="{{ 'PJR-PINTEREST10-pin.jpg' | asset_url }}"
      alt="{{ section.settings.heading | escape }}"
      width="1000"
      height="1500"
      loading="lazy"
    >
  </a>
  <div class="pin-promo__copy">
    {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.cta != blank %}
      <a class="btn" href="{{ section.settings.link | default: '/discount/PINTEREST10' }}">{{ section.settings.cta }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Pinterest pin",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pinterest" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "PINTEREST10" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "10% off. Hard work. Real cloth. Forged in the kitchen." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Use the code" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Pinterest pin" }]
}
{% endschema %}
