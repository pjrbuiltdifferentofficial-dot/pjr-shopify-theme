<section class="pin-promo">
  <a class="pin-promo__media" href="{{ section.settings.link | default: '/collections/mens' }}">
    <img
      src="{{ 'lookbook-hoodie.jpg' | asset_url }}"
      alt="{{ section.settings.heading | escape }}"
      width="1000"
      height="1500"
      loading="lazy"
    >
  </a>
  <div class="pin-promo__copy">
    {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.cta != blank %}
      <a class="btn" href="{{ section.settings.link | default: '/collections/mens' }}">{{ section.settings.cta }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Drop promo",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The line" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Next drop. Not spam." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Heavyweight pieces. No weekly merch cycle." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Open the shop" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Drop promo" }]
}
{% endschema %}
