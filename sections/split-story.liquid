<section class="split">
  <div class="split__media" {% if section.settings.flip %}style="order:2"{% endif %}>
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.heading }}
    {% else %}
      <img src="{{ section.settings.fallback | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {% endif %}
  </div>
  <div class="split__copy" {% if section.settings.flip %}style="order:1"{% endif %}>
    {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.cta != blank %}
      <a class="btn{% if section.settings.ghost %} btn--ghost{% endif %}" href="{{ section.settings.link }}">{{ section.settings.cta }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Split story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback", "label": "Fallback asset", "options": [
      { "value": "lookbook-fjord.jpg", "label": "Fjord" },
      { "value": "story-hands.jpg", "label": "Hands" },
      { "value": "father-son.jpg", "label": "Father & Son" },
      { "value": "texture-cotton.jpg", "label": "Texture" }
    ], "default": "lookbook-fjord.jpg" },
    { "type": "checkbox", "id": "flip", "label": "Text on the left", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Legacy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Father & Son — A Bond That Never Breaks" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "This brand did not start as a business plan. It started as a promise. Twenty years in the kitchen — twelve of them in Norway — so a son could watch what it looks like to build something with your own hands. No shortcuts. No investors." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Shop Legacy" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "ghost", "label": "Ghost button", "default": false }
  ],
  "presets": [{ "name": "Split story" }]
}
{% endschema %}
