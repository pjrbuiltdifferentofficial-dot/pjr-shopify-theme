<div>
  <header class="page-width" style="padding:3rem 0 2rem;">
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h1 style="margin-top:0.5rem;font-size:var(--text-hero);text-transform:uppercase;">{{ section.settings.heading | default: page.title }}</h1>
    <p class="section__sub">{{ section.settings.intro }}</p>
  </header>
  <div class="look-grid look-grid--wide">
    {% for block in section.blocks %}
      <figure {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: block.settings.caption }}
        {% else %}
          <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy">
        {% endif %}
        {% if block.settings.caption != blank %}
          <figcaption class="look-cap">{{ block.settings.caption }}</figcaption>
        {% endif %}
      </figure>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Lookbook page",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Campaign" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built between the shifts." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Kitchen, fjord, wet asphalt. Same clothes." }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "Shot",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "fallback", "label": "Fallback", "options": [
          { "value": "hero-kitchen.jpg", "label": "Kitchen" },
          { "value": "lookbook-fjord.jpg", "label": "Fjord" },
          { "value": "lookbook-cliff.jpg", "label": "Cliff" },
          { "value": "lookbook-rain.jpg", "label": "Rain" },
          { "value": "story-hands.jpg", "label": "Hands" },
          { "value": "story-kitchen.jpg", "label": "Kitchen 2am" }
        ], "default": "lookbook-cliff.jpg" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ]
}
{% endschema %}
