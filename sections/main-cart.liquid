<div class="page-width">
  {% if cart.item_count == 0 %}
    <div class="empty">
      <h1>{{ 'cart.empty' | t }}</h1>
      <a class="btn" href="{{ routes.all_products_collection_url }}" style="margin-top:2rem;">{{ 'cart.empty_cta' | t }}</a>
    </div>
  {% else %}
    <div class="cart-page">
      <div>
        <h1 style="font-size:var(--text-title);text-transform:uppercase;margin-bottom:2rem;">{{ 'cart.title' | t }}</h1>
        {% for item in cart.items %}
          <div class="cart-line">
            <a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 200 | image_tag: alt: item.title }}{% endif %}</a>
            <div style="flex:1;">
              <div class="cart-line__title">{{ item.product_title }}</div>
              <div class="cart-line__meta">{{ item.variant_title }} · ×{{ item.quantity }}</div>
            </div>
            <div>{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>
      <aside class="cart-summary">
        <p class="kicker">{{ 'cart.title' | t }}</p>
        <div class="cart-row" style="margin-top:1rem;">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <form action="{{ routes.cart_url }}" method="post">
          <button class="btn btn--full" type="submit" name="checkout" style="margin-top:1.5rem;">{{ 'cart.checkout' | t }}</button>
        </form>
      </aside>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
