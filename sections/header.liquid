<header class="site-header">
  <div class="page-width site-header__inner">
    <div class="site-header__lead">
      <button type="button" class="menu-toggle" data-open-menu aria-label="{{ 'general.menu' | t }}" aria-expanded="false" aria-controls="NavDrawer">
        {% render 'icon-menu' %}
      </button>
      <nav class="site-header__nav" aria-label="{{ 'nav.shop' | t }}">
        {% render 'site-nav', variant: 'bar' %}
      </nav>
    </div>
    {% render 'wordmark' %}
    <div class="site-header__actions">
      <a href="{{ routes.cart_url }}" class="site-header__icon" data-open-cart aria-label="{{ 'general.cart' | t }}">
        {% render 'icon-bag' %}
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="drawer-backdrop" data-menu-backdrop></div>
<aside class="nav-drawer" id="NavDrawer" aria-hidden="true" inert aria-label="{{ 'general.menu' | t }}">
  <div style="display:flex;justify-content:space-between;align-items:center;">
    {% render 'wordmark', compact: true %}
    <button type="button" class="site-header__icon" data-close-menu aria-label="{{ 'general.close' | t }}">
      {% render 'icon-close' %}
    </button>
  </div>
  <nav>
    {% render 'site-nav', variant: 'drawer' %}
  </nav>
</aside>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Not used. Header links are the catalog menu in the theme.",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
