{% if section.settings.text != blank %}
  <div class="announcement">{{ section.settings.text }}</div>
{% endif %}

{% schema %}
{
  "name": "Announcement",
  "class": "announcement-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Norway: 119 kr shipping · Free from 1 500 kr"
    }
  ]
}
{% endschema %}
