<article class="section b2b-page">
  <div class="page-width b2b-page__intro">
    <p class="kicker">{{ 'b2b.kicker' | t }}</p>
    <h1>{{ 'b2b.heading' | t }}</h1>
    <p class="section__sub">{{ 'b2b.intro' | t }}</p>
    <p class="b2b-page__mail"><a href="mailto:pjrbuiltdifferentofficial@gmail.com">pjrbuiltdifferentofficial@gmail.com</a></p>
  </div>

  <section class="page-width kitchen-line" aria-labelledby="kitchen-line-title">
    <p class="kicker">{{ 'b2b.line_kicker' | t }}</p>
    <h2 id="kitchen-line-title">{{ 'b2b.line_title' | t }}</h2>
    <div class="kitchen-line__grid">
      <figure class="kitchen-line__card">
        {% render 'kitchen-line-image',
          stem: 'kitchen-line-classic',
          alt: 'b2b.line_classic_alt' | t,
          width: 1500,
          height: 844,
          loading: 'eager',
          sizes: '(min-width: 1024px) 30vw, 92vw'
        %}
        <figcaption>{{ 'b2b.line_classic' | t }}</figcaption>
      </figure>
      <figure class="kitchen-line__card">
        {% render 'kitchen-line-image',
          stem: 'kitchen-line-fire-steel',
          alt: 'b2b.line_fire_alt' | t,
          width: 1152,
          height: 864
        %}
        <figcaption>{{ 'b2b.line_fire' | t }}</figcaption>
      </figure>
      <figure class="kitchen-line__card">
        {% render 'kitchen-line-image',
          stem: 'kitchen-line-nordic-chef',
          alt: 'b2b.line_nordic_alt' | t,
          width: 1152,
          height: 864
        %}
        <figcaption>{{ 'b2b.line_nordic' | t }}</figcaption>
      </figure>
    </div>
    <p class="kitchen-line__caption">{{ 'b2b.line_caption' | t }}</p>
    <a class="btn" href="#B2BInquiry">{{ 'b2b.line_cta' | t }}</a>
  </section>

  <div class="page-width b2b-page__form">
  {% form 'contact', id: 'B2BInquiry', class: 'b2b-form form-grid' %}
    {% if form.posted_successfully? %}
      <p class="kicker">{{ 'b2b.success_kicker' | t }}</p>
      <h2>{{ 'b2b.success_title' | t }}</h2>
      <p>{{ 'b2b.success' | t }}</p>
    {% else %}
      {{ form.errors | default_errors }}
      <input type="hidden" name="contact[tags]" value="B2B">
      <label>
        <span>{{ 'b2b.name' | t }}</span>
        <input class="field" type="text" name="contact[name]" autocomplete="name" required>
      </label>
      <label>
        <span>{{ 'b2b.email' | t }}</span>
        <input class="field" type="email" name="contact[email]" autocomplete="email" required>
      </label>
      <label>
        <span>{{ 'b2b.phone' | t }}</span>
        <input class="field" type="tel" name="contact[phone]" autocomplete="tel">
      </label>
      <label>
        <span>{{ 'b2b.company' | t }}</span>
        <input class="field" type="text" name="contact[company]" autocomplete="organization" required>
      </label>
      <label>
        <span>{{ 'b2b.type' | t }}</span>
        <select class="field" name="contact[team_type]" required>
          <option value="Restaurant">{{ 'b2b.type_restaurant' | t }}</option>
          <option value="Gym">{{ 'b2b.type_gym' | t }}</option>
          <option value="Company">{{ 'b2b.type_company' | t }}</option>
          <option value="Other">{{ 'b2b.type_other' | t }}</option>
        </select>
      </label>
      <label>
        <span>{{ 'b2b.country' | t }}</span>
        <input class="field" type="text" name="contact[country]" value="Norway" autocomplete="country-name">
      </label>
      <label>
        <span>{{ 'b2b.pieces' | t }}</span>
        <input class="field" type="text" name="contact[pieces]" placeholder="{{ 'b2b.pieces_placeholder' | t }}">
      </label>
      <label>
        <span>{{ 'b2b.needed' | t }}</span>
        <input class="field" type="text" name="contact[needed_by]" placeholder="{{ 'b2b.needed_placeholder' | t }}">
      </label>
      <label>
        <span>{{ 'b2b.message' | t }}</span>
        <textarea class="field b2b-form__area" name="contact[body]" rows="5" required placeholder="{{ 'b2b.message_placeholder' | t }}"></textarea>
      </label>
      <button class="btn" type="submit">{{ 'b2b.submit' | t }}</button>
    {% endif %}
  {% endform %}
  </div>
</article>

{% stylesheet %}
.b2b-page__intro,
.b2b-page__form { max-width: 40rem; }
.b2b-page h1 {
  margin-top: 0.6rem;
  font-size: var(--text-hero);
  text-transform: uppercase;
}
.b2b-page__mail { margin-top: 1.25rem; }
.b2b-page__mail a { text-decoration: underline; text-underline-offset: 3px; }
.kitchen-line { margin-top: 3.5rem; }
.kitchen-line h2 {
  margin-top: 0.55rem;
  font-size: var(--text-title);
  text-transform: uppercase;
}
.kitchen-line__grid {
  display: grid;
  gap: 0.75rem;
  margin-top: 1.5rem;
}
@media (min-width: 800px) {
  .kitchen-line__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
}
.kitchen-line__card {
  margin: 0;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
}
.kitchen-line__card picture,
.kitchen-line__card img { display: block; width: 100%; }
.kitchen-line__card img {
  height: auto;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  object-position: center;
}
.kitchen-line__card figcaption {
  padding: 0.85rem 1rem 1rem;
  font-family: var(--font-display);
  font-size: 0.85rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.kitchen-line__caption {
  margin-top: 1.35rem;
  max-width: 40rem;
  color: var(--color-muted);
}
.kitchen-line .btn { margin-top: 1.5rem; }
.b2b-page__form { margin-top: 3.5rem; }
.b2b-form { scroll-margin-top: 5.5rem; }
.b2b-form__area { height: auto; padding: 0.85rem 1rem; resize: vertical; }
.b2b-form .btn { justify-self: start; }
{% endstylesheet %}

{% schema %}
{
  "name": "B2B inquiry",
  "settings": []
}
{% endschema %}
