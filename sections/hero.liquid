<section class="hero">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero__img', alt: '', widths: '600, 900, 1200, 1600, 2000', sizes: '100vw', fetchpriority: 'high', loading: 'eager' }}
  {% else %}
    <img class="hero__img" src="{{ 'hero-kitchen.jpg' | asset_url }}" alt="" fetchpriority="high" width="2400" height="1350">
  {% endif %}
  <div class="hero__shade"></div>
  <div class="page-width hero__content">
    {% if section.settings.kicker != blank %}
      <p class="kicker" style="color:color-mix(in srgb, var(--color-fg) 80%, transparent);">{{ section.settings.kicker }}</p>
    {% endif %}
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    <p class="hero__line">Heavyweight. Garment-dyed. Cut for the shift.</p>
    <div class="hero__actions">
      {% if section.settings.btn_label != blank %}
        {%- capture hero_shop -%}{%- render 'collection-url', handle: 'new-in', fallback: 'mens' -%}{%- endcapture -%}
        <a class="btn" href="{{ section.settings.btn_link | default: hero_shop | strip }}">{{ section.settings.btn_label }}</a>
      {% endif %}
      {% if section.settings.btn2_label != blank %}
        <a class="btn btn--ghost" href="{{ section.settings.btn2_link | default: pages.story.url | default: '/pages/story' }}">{{ section.settings.btn2_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "FORGED IN THE KITCHEN" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "HARD WORK\nREAL AMBITION\nNO DAYS OFF" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "New in" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "text", "id": "btn2_label", "label": "Second button", "default": "The story" },
    { "type": "url", "id": "btn2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
