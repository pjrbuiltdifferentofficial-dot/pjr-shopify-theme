<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {% assign items = section.settings.text | split: '|' %}
    {% for n in (1..2) %}
      {% for item in items %}
        <span>{{ item | strip }} <span style="color:var(--color-subtle);margin-left:2.5rem;">·</span></span>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Items, separated by |",
      "default": "FORGED IN THE KITCHEN | TWENTY YEARS | NO INVESTORS | NO SHORTCUTS | FOR THE SON | WE DO IT OUR WAY | HARD WORK | NO DAYS OFF"
    }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
