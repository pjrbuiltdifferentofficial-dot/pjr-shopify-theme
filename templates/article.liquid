<article class="page-width" style="max-width:760px;margin:0 auto;padding:48px 20px;">
  <p style="opacity:.7;text-transform:uppercase;letter-spacing:.1em;font-size:12px;"><a href="{{ blog.url }}">{{ blog.title }}</a> · {{ article.published_at | date: '%d %b %Y' }}</p>
  <h1>{{ article.title }}</h1>
  {%- if article.image %}<img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="1200" style="width:100%;height:auto;margin:24px 0;" loading="eager">{%- endif %}
  <div class="rte">{{ article.content }}</div>
  <p style="margin-top:40px;opacity:.7;">{{ article.author }}</p>
</article>
