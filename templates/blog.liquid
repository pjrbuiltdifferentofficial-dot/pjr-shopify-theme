<section class="page-width" style="max-width:960px;margin:0 auto;padding:48px 20px;">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:32px;margin-top:32px;">
    {%- for article in blog.articles -%}
    <a href="{{ article.url }}" style="text-decoration:none;color:inherit;">
      {%- if article.image %}<img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" width="600" style="width:100%;height:auto;" loading="lazy">{%- endif %}
      <h2 style="font-size:20px;margin:12px 0 6px;">{{ article.title }}</h2>
      <p style="opacity:.7;font-size:14px;">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
    </a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 %}{{ paginate | default_pagination }}{% endif -%}
  {%- endpaginate -%}
</section>
